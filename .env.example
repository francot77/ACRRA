RESULTS_DIR=/app/results
DATABASE_PATH=/app/data/ac-race-monitor.sqlite
# Verified acrra-incident-archive-v1 files are written here during migration 2.
# Empty uses the directory containing DATABASE_PATH.
DATABASE_ARCHIVE_DIR=/app/data
DISCORD_WEBHOOK_URL=
# Deprecated compatibility settings: retained for parsing and deprecation warnings.
# They are ignored and cannot activate UDP, live incidents, or heuristic verdicts.
INCIDENTS_DISCORD_WEBHOOK_URL=
INCIDENTS_WEBHOOK_ENABLED=false
LIVE_UDP_ENABLED=false
AC_UDP_SERVER_HOST=127.0.0.1
AC_UDP_SERVER_PLUGIN_PORT=11000
AC_UDP_PLUGIN_LISTEN_PORT=12000
REALTIME_REPORT_INTERVAL_MS=250
SNAPSHOT_RING_BUFFER_MS=10000
INCIDENT_PRE_MS=3000
INCIDENT_POST_MS=1500
INCIDENT_MATCH_MAX_DISTANCE_M=30
INCIDENT_MATCH_MAX_IMPACT_DIFF_KMH=35
PROCESSED_FILE_STRATEGY=sqlite
SCAN_ON_START=true
MIN_FILE_AGE_MS=3000
WATCH_GLOB=*RACE*.json
# Phase-2 scoring foundation; disabled until scoring persistence/reporting is enabled.
SCORING_ENABLED=false
SCORING_SOURCE_GLOB=*_RACE.json
SCORING_SCHEDULE=0 21 * * *
SCORING_TIMEZONE=America/Argentina/Buenos_Aires
SCORING_RACE_WINDOW_MINUTES=60
SCORING_DST_POLICY=reject-ambiguous
# Dedicated championship results delivery; keep separate from the general race report.
SCORING_RESULTS_WEBHOOK_URL=
DEFAULT_SAFETY_RATING=75
SAFETY_MEMORY_FACTOR=0.85
MIN_ACTIVE_DRIVERS_FOR_SAFETY_GAIN=3
NUCLEAR_MISSILE_MIN_CAR_IMPACT_KMH=100
NODE_ENV=production
HOST_ASSETTO_RESULTS_DIR=/opt/assetto/server/results
HOST_MONITOR_DATA_DIR=/opt/ac-race-monitor/data
